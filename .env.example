# Ports (change if 80/443 are already in use on the host)
HTTP_PORT=80
HTTPS_PORT=443

# Flask Configuration
FLASK_APP=app
FLASK_ENV=production

# SECRET_KEY and MASTER_ENCRYPTION_KEY live in a separate file outside the repo
# so they never land in source control. Default location is
# $HOME/.config/infrared/secrets.env (user-owned, no sudo). Override with
# INFRARED_SECRETS_FILE (uncomment below). ./setup.sh generates both files.
# INFRARED_SECRETS_FILE=/path/to/secrets.env

# Database
DATABASE_URL=postgresql://infrared:infrared_password@postgres:5432/infrared

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# API Keys (configure via the Settings page after first login)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# CLOUDFLARE_API_TOKEN=
# MAILGUN_API_KEY=
# NPM_API_URL=
# NPM_API_TOKEN=
