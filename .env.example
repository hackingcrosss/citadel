# Ports (change if 80/443 are already in use on the host)
HTTP_PORT=80
HTTPS_PORT=443

# Flask Configuration
FLASK_APP=app
FLASK_ENV=production

# Bootstrap admin. If INITIAL_ADMIN_PASSWORD is omitted, init_db.py generates
# a one-time strong password and prints it once. Never use admin/admin.
# INITIAL_ADMIN_EMAIL=admin@citadel.local
# INITIAL_ADMIN_PASSWORD=

# Session / remember-me hardening defaults. SESSION_COOKIE_SECURE and
# REMEMBER_COOKIE_SECURE are automatically true unless FLASK_ENV=development.
SESSION_COOKIE_SAMESITE=Strict
SESSION_LIFETIME_HOURS=8
REMEMBER_COOKIE_SAMESITE=Strict
REMEMBER_COOKIE_DAYS=14
PASSWORD_HASH_METHOD=scrypt
PASSWORD_HASH_SALT_LENGTH=16

# SECRET_KEY and MASTER_ENCRYPTION_KEY live in a separate file outside the repo
# so they never land in source control. Default location is
# $HOME/.config/citadel/secrets.env (user-owned, no sudo). Override with
# CITADEL_SECRETS_FILE (uncomment below). ./setup.sh generates both files.
# CITADEL_SECRETS_FILE=/path/to/secrets.env

# Database / Redis / Celery URLs live in the secrets file (with passwords
# embedded). setup.sh writes them to $CITADEL_SECRETS_FILE on first install.
# Do NOT add them here — anything in .env is overridden by the secrets file
# env_file load order, and leaving stale weak-password URLs in .env is a
# footgun.

# API Keys (configure via the Settings page after first login)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# CLOUDFLARE_API_TOKEN=
# MAILGUN_API_KEY=
# NPM_API_URL=
# NPM_API_TOKEN=
