# Flask Configuration
FLASK_APP=app
FLASK_ENV=development
SECRET_KEY=change-me-to-random-secret-key
MASTER_ENCRYPTION_KEY=change-me-to-32-byte-base64-key

# Database
DATABASE_URL=postgresql://infrared:infrared_password@postgres:5432/infrared

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# API Keys (will be encrypted and stored in DB, these are for initial setup)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# CLOUDFLARE_API_TOKEN=
# MAILGUN_API_KEY=
# NPM_API_URL=
# NPM_API_TOKEN=